<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      values-v27 과 같은데 노치 값만 always 다.

      shortEdges 는 '짧은 변 쪽 구멍만' 이라는 뜻이다. 폴더블 안쪽 화면처럼 거의
      정사각형인 디스플레이에서는 어느 쪽이 짧은 변인지가 애매해 기대와 다르게
      걸릴 수 있다. always 는 방향과 상관없이 구멍 자리까지 창을 넓힌다.

      always 는 API 30 부터라 여기서만 얹는다.
    -->
    <style name="Theme.PikaPlayer" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">#0C0C0E</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLayoutInDisplayCutoutMode">always</item>
    </style>
</resources>
