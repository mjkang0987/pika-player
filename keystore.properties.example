# 실제 값은 keystore.properties 로 복사해서 채운다. 그 파일은 .gitignore 에 있다.
#
# storeFile 은 저장소 밖의 절대 경로를 권한다. 안에 두면 언젠가 실수로 커밋된다.
# ~/ 로 시작해도 된다 — 빌드가 풀어 준다. 아래 예시 줄을 통째로 바꿔 쓸 것.
# 키를 잃으면 이 앱은 영영 업데이트할 수 없다 — 파일과 비밀번호를 저장소가 아닌
# 곳(비밀번호 관리자·클라우드 드라이브)에 따로 백업해 둘 것.
storeFile=~/pika-release.jks
storePassword=
keyAlias=pika
keyPassword=
